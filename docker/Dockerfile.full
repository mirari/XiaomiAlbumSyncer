FROM node:24.20.0-bookworm-slim AS frontend
WORKDIR /src/web
RUN corepack enable && corepack prepare yarn@4.18.0 --activate
COPY web/ ./
RUN yarn install --immutable && yarn lint && yarn format && yarn build

FROM eclipse-temurin:25-jdk-noble AS backend
WORKDIR /src/server
COPY server/ ./
COPY --from=frontend /src/web/dist/ ./src/main/resources/static/
ARG VERSION=mirror-dev
RUN bash ./gradlew clean compileKotlin test solonJar -PappVersion=${VERSION} --no-daemon

FROM eclipse-temurin:25-jre-noble
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libimage-exiftool-perl python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* && python3 -m venv /opt/mirror-venv
COPY mirror/requirements.txt /app/mirror/requirements.txt
RUN /opt/mirror-venv/bin/pip install --no-cache-dir -r /app/mirror/requirements.txt
COPY mirror/engine.py mirror/xiaomi.py mirror/worker.py /app/mirror/
COPY --from=backend /src/server/build/libs/*.jar /app/app.jar
ENV JAVA_OPTS="--enable-native-access=ALL-UNNAMED" TZ=Asia/Shanghai
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
